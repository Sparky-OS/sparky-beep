#!/bin/bash
#
# Sparky Beep Composer TUI
# Interactive text-based music composer for beep compositions
# Uses dialog/whiptail for user interface
# last update 2025/11/20
#

# Determine script directory
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
LIB_DIR="$(dirname "$SCRIPT_DIR")/lib"
LOCALE_DIR="$(dirname "$SCRIPT_DIR")/locale"
COMPOSITIONS_DIR="$(dirname "$SCRIPT_DIR")/compositions"

# Source required libraries
. "${LIB_DIR}/notes.sh" || exit 1
. "${LIB_DIR}/config.sh" || exit 1
. "${LOCALE_DIR}/i18n.sh" || exit 1

# Detect dialog utility (prefer whiptail, fallback to dialog)
DIALOG_CMD=""
if command -v whiptail >/dev/null 2>&1; then
    DIALOG_CMD="whiptail"
elif command -v dialog >/dev/null 2>&1; then
    DIALOG_CMD="dialog"
else
    echo "ERROR: Neither whiptail nor dialog is installed." >&2
    echo "Please install one of: whiptail, dialog" >&2
    exit 1
fi

# Dialog dimensions
DIALOG_HEIGHT=20
DIALOG_WIDTH=70
DIALOG_LIST_HEIGHT=12

# Temporary file for dialog output
DIALOG_TEMP=$(mktemp)
trap 'rm -f "$DIALOG_TEMP"' EXIT

# Composition state
COMPOSITION_NOTES=()
COMPOSITION_TEMPO=120
COMPOSITION_FILENAME=""
COMPOSITION_DESCRIPTION=""
COMPOSITION_CHANGED=0

# User compositions directory
USER_COMPOSITIONS_DIR="${HOME}/.local/share/sparky-beep/compositions"
mkdir -p "$USER_COMPOSITIONS_DIR"

#
# Function: dialog_msgbox
# Description: Show a message box
# Usage: dialog_msgbox <title> <message>
#
dialog_msgbox() {
    local title="$1"
    local message="$2"

    $DIALOG_CMD --title "$title" \
        --msgbox "$message" \
        $DIALOG_HEIGHT $DIALOG_WIDTH
}

#
# Function: dialog_yesno
# Description: Show a yes/no dialog
# Usage: dialog_yesno <title> <message>
#
dialog_yesno() {
    local title="$1"
    local message="$2"

    $DIALOG_CMD --title "$title" \
        --yesno "$message" \
        $DIALOG_HEIGHT $DIALOG_WIDTH
}

#
# Function: dialog_menu
# Description: Show a menu
# Usage: dialog_menu <title> <message> <options...>
#
dialog_menu() {
    local title="$1"
    local message="$2"
    shift 2

    $DIALOG_CMD --title "$title" \
        --menu "$message" \
        $DIALOG_HEIGHT $DIALOG_WIDTH $DIALOG_LIST_HEIGHT \
        "$@" 2>"$DIALOG_TEMP"

    local result=$?
    if [ $result -eq 0 ]; then
        cat "$DIALOG_TEMP"
        return 0
    fi
    return 1
}

#
# Function: dialog_inputbox
# Description: Show an input box
# Usage: dialog_inputbox <title> <message> [default]
#
dialog_inputbox() {
    local title="$1"
    local message="$2"
    local default="$3"

    $DIALOG_CMD --title "$title" \
        --inputbox "$message" \
        $DIALOG_HEIGHT $DIALOG_WIDTH \
        "$default" 2>"$DIALOG_TEMP"

    local result=$?
    if [ $result -eq 0 ]; then
        cat "$DIALOG_TEMP"
        return 0
    fi
    return 1
}

#
# Function: show_main_menu
# Description: Show the main composer menu
#
show_main_menu() {
    while true; do
        local notes_count=${#COMPOSITION_NOTES[@]}
        local status_line="$(printf "$(t COMPOSER_CURRENT_TEMPO)" "$COMPOSITION_TEMPO") | $notes_count $(t PLAYER_NP_NOTES)"

        local choice=$(dialog_menu \
            "$(t COMPOSER_TITLE)" \
            "$status_line" \
            "1" "$(t COMPOSER_NEW)" \
            "2" "$(t COMPOSER_OPEN)" \
            "3" "$(t COMPOSER_SAVE)" \
            "4" "$(t COMPOSER_SAVE_AS)" \
            "5" "$(t COMPOSER_ADD_NOTE)" \
            "6" "$(t COMPOSER_ADD_REST)" \
            "7" "$(t COMPOSER_EDIT_NOTE)" \
            "8" "$(t COMPOSER_DELETE_NOTE)" \
            "9" "$(t COMPOSER_SET_TEMPO)" \
            "10" "$(t COMPOSER_PLAY)" \
            "11" "$(t COMPOSER_EXPORT)" \
            "12" "$(t MENU_EXIT)")

        case "$choice" in
            1) new_composition ;;
            2) open_composition ;;
            3) save_composition ;;
            4) save_composition_as ;;
            5) add_note ;;
            6) add_rest ;;
            7) edit_note ;;
            8) delete_note ;;
            9) set_tempo ;;
            10) play_composition ;;
            11) export_composition ;;
            12)
                if [ $COMPOSITION_CHANGED -eq 1 ]; then
                    if dialog_yesno "$(t MENU_EXIT)" "$(t COMPOSER_UNSAVED_CHANGES)"; then
                        break
                    fi
                else
                    break
                fi
                ;;
            *) break ;;
        esac
    done
}

#
# Function: new_composition
# Description: Create a new composition
#
new_composition() {
    if [ $COMPOSITION_CHANGED -eq 1 ]; then
        if ! dialog_yesno "$(t COMPOSER_NEW)" "$(t COMPOSER_UNSAVED_CHANGES)"; then
            return
        fi
    fi

    COMPOSITION_NOTES=()
    COMPOSITION_TEMPO=120
    COMPOSITION_FILENAME=""
    COMPOSITION_DESCRIPTION=""
    COMPOSITION_CHANGED=0

    dialog_msgbox "$(t COMPOSER_NEW)" "$(t COMPOSER_CLEAR)"
}

#
# Function: open_composition
# Description: Open an existing composition
#
open_composition() {
    if [ $COMPOSITION_CHANGED -eq 1 ]; then
        if ! dialog_yesno "$(t COMPOSER_OPEN)" "$(t COMPOSER_UNSAVED_CHANGES)"; then
            return
        fi
    fi

    # Build list of available compositions
    local options=()

    # Add compositions from all directories
    for dir in "$COMPOSITIONS_DIR" "$USER_COMPOSITIONS_DIR" "$SYSTEM_TUNES_DIR"; do
        [ ! -d "$dir" ] && continue

        while IFS= read -r -d '' file; do
            local basename=$(basename "$file" .beepmusic)
            local desc=$(grep "^# Description:" "$file" 2>/dev/null | sed 's/^# Description: //' || echo "$basename")
            options+=("$file" "$desc")
        done < <(find "$dir" -name "*.beepmusic" -type f -print0 2>/dev/null)
    done

    if [ ${#options[@]} -eq 0 ]; then
        dialog_msgbox "$(t COMPOSER_OPEN)" "$(t PLAYER_NO_COMPOSITIONS)"
        return
    fi

    local selected=$(dialog_menu \
        "$(t COMPOSER_OPEN)" \
        "$(t COMPOSER_OPEN)" \
        "${options[@]}")

    if [ -n "$selected" ] && [ -f "$selected" ]; then
        load_composition_file "$selected"
    fi
}

#
# Function: load_composition_file
# Description: Load composition from file
#
load_composition_file() {
    local file="$1"

    COMPOSITION_NOTES=()
    COMPOSITION_TEMPO=120

    # Read file and parse
    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^#.*$ ]] && continue
        [[ -z "$line" ]] && continue

        # Check for tempo directive
        if [[ "$line" =~ ^tempo:([0-9]+)$ ]]; then
            COMPOSITION_TEMPO="${BASH_REMATCH[1]}"
            continue
        fi

        # Parse notes
        for token in $line; do
            # Skip empty tokens
            [ -z "$token" ] && continue

            # Add token to composition
            COMPOSITION_NOTES+=("$token")
        done
    done < "$file"

    COMPOSITION_FILENAME="$file"
    COMPOSITION_CHANGED=0

    dialog_msgbox "$(t COMPOSER_OPEN)" "$(printf "$(t COMPOSER_LOAD_SUCCESS)" "$(basename "$file")")"
}

#
# Function: save_composition
# Description: Save current composition
#
save_composition() {
    if [ -z "$COMPOSITION_FILENAME" ]; then
        save_composition_as
        return
    fi

    write_composition_file "$COMPOSITION_FILENAME"
}

#
# Function: save_composition_as
# Description: Save composition with new filename
#
save_composition_as() {
    local filename=$(dialog_inputbox \
        "$(t COMPOSER_SAVE_AS)" \
        "$(t COMPOSER_FILENAME)" \
        "$(basename "$COMPOSITION_FILENAME" .beepmusic)")

    [ -z "$filename" ] && return

    # Add .beepmusic extension if not present
    [[ "$filename" != *.beepmusic ]] && filename="${filename}.beepmusic"

    local filepath="${USER_COMPOSITIONS_DIR}/${filename}"

    # Check if file exists
    if [ -f "$filepath" ]; then
        if ! dialog_yesno "$(t COMPOSER_SAVE_AS)" "$(t COMPOSER_FILE_EXISTS)"; then
            return
        fi
    fi

    # Ask for description
    local description=$(dialog_inputbox \
        "$(t COMPOSER_SAVE_AS)" \
        "$(t COMPOSER_DESCRIPTION)" \
        "$COMPOSITION_DESCRIPTION")

    COMPOSITION_DESCRIPTION="$description"
    COMPOSITION_FILENAME="$filepath"

    write_composition_file "$filepath"
}

#
# Function: write_composition_file
# Description: Write composition to file
#
write_composition_file() {
    local filepath="$1"

    {
        echo "# Composition created with Sparky Beep Composer"
        [ -n "$COMPOSITION_DESCRIPTION" ] && echo "# Description: $COMPOSITION_DESCRIPTION"
        echo "# Category: user"
        echo ""
        echo "tempo:${COMPOSITION_TEMPO}"
        echo ""

        # Write notes (6 per line for readability)
        local count=0
        for note in "${COMPOSITION_NOTES[@]}"; do
            echo -n "$note "
            count=$((count + 1))
            if [ $((count % 6)) -eq 0 ]; then
                echo ""
            fi
        done
        echo ""
    } > "$filepath"

    COMPOSITION_CHANGED=0
    dialog_msgbox "$(t COMPOSER_SAVE)" "$(printf "$(t COMPOSER_SAVE_SUCCESS)" "$(basename "$filepath")")"
}

#
# Function: add_note
# Description: Add a note to composition
#
add_note() {
    # Select note
    local note=$(dialog_menu \
        "$(t COMPOSER_ADD_NOTE)" \
        "$(t COMPOSER_NOTE_LABEL)" \
        "C" "C" "C#" "C#/Db" "D" "D" "D#" "D#/Eb" \
        "E" "E" "F" "F" "F#" "F#/Gb" "G" "G" \
        "G#" "G#/Ab" "A" "A" "A#" "A#/Bb" "B" "B")

    [ -z "$note" ] && return

    # Select octave
    local octave=$(dialog_menu \
        "$(t COMPOSER_ADD_NOTE)" \
        "$(t COMPOSER_OCTAVE_LABEL)" \
        "2" "2 (Low)" "3" "3" "4" "4 (Middle)" "5" "5" "6" "6 (High)" "7" "7")

    [ -z "$octave" ] && return

    # Select duration
    local duration=$(dialog_menu \
        "$(t COMPOSER_ADD_NOTE)" \
        "$(t COMPOSER_DURATION_LABEL)" \
        "w" "$(t COMPOSER_DURATION_WHOLE)" \
        "h" "$(t COMPOSER_DURATION_HALF)" \
        "q" "$(t COMPOSER_DURATION_QUARTER)" \
        "e" "$(t COMPOSER_DURATION_EIGHTH)" \
        "s" "$(t COMPOSER_DURATION_SIXTEENTH)")

    [ -z "$duration" ] && return

    # Add note to composition
    local note_str="${note}${octave}${duration}"
    COMPOSITION_NOTES+=("$note_str")
    COMPOSITION_CHANGED=1

    # Ask if user wants to preview
    if dialog_yesno "$(t COMPOSER_PREVIEW_NOTE)" "$(t COMPOSER_PREVIEW_NOTE)?"; then
        preview_note "$note_str"
    fi
}

#
# Function: add_rest
# Description: Add a rest to composition
#
add_rest() {
    # Select duration
    local duration=$(dialog_menu \
        "$(t COMPOSER_ADD_REST)" \
        "$(t COMPOSER_DURATION_LABEL)" \
        "w" "$(t COMPOSER_DURATION_WHOLE)" \
        "h" "$(t COMPOSER_DURATION_HALF)" \
        "q" "$(t COMPOSER_DURATION_QUARTER)" \
        "e" "$(t COMPOSER_DURATION_EIGHTH)" \
        "s" "$(t COMPOSER_DURATION_SIXTEENTH)")

    [ -z "$duration" ] && return

    # Add rest to composition
    local rest_str="r:${duration}"
    COMPOSITION_NOTES+=("$rest_str")
    COMPOSITION_CHANGED=1
}

#
# Function: edit_note
# Description: Edit an existing note
#
edit_note() {
    if [ ${#COMPOSITION_NOTES[@]} -eq 0 ]; then
        dialog_msgbox "$(t COMPOSER_EDIT_NOTE)" "$(t COMPOSER_EMPTY)"
        return
    fi

    # Build list of notes
    local options=()
    local index=0
    for note in "${COMPOSITION_NOTES[@]}"; do
        options+=("$index" "$note")
        index=$((index + 1))
    done

    local selected=$(dialog_menu \
        "$(t COMPOSER_EDIT_NOTE)" \
        "$(t COMPOSER_EDIT_NOTE)" \
        "${options[@]}")

    [ -z "$selected" ] && return

    # For simplicity, delete and add new note
    delete_note_by_index "$selected"
    add_note
}

#
# Function: delete_note
# Description: Delete a note from composition
#
delete_note() {
    if [ ${#COMPOSITION_NOTES[@]} -eq 0 ]; then
        dialog_msgbox "$(t COMPOSER_DELETE_NOTE)" "$(t COMPOSER_EMPTY)"
        return
    fi

    # Build list of notes
    local options=()
    local index=0
    for note in "${COMPOSITION_NOTES[@]}"; do
        options+=("$index" "$note")
        index=$((index + 1))
    done

    local selected=$(dialog_menu \
        "$(t COMPOSER_DELETE_NOTE)" \
        "$(t COMPOSER_DELETE_NOTE)" \
        "${options[@]}")

    [ -z "$selected" ] && return

    delete_note_by_index "$selected"
}

#
# Function: delete_note_by_index
# Description: Delete note at specific index
#
delete_note_by_index() {
    local index="$1"

    # Create new array without the selected note
    local new_notes=()
    local i=0
    for note in "${COMPOSITION_NOTES[@]}"; do
        if [ $i -ne "$index" ]; then
            new_notes+=("$note")
        fi
        i=$((i + 1))
    done

    COMPOSITION_NOTES=("${new_notes[@]}")
    COMPOSITION_CHANGED=1
}

#
# Function: set_tempo
# Description: Set composition tempo
#
set_tempo() {
    local tempo=$(dialog_inputbox \
        "$(t COMPOSER_SET_TEMPO)" \
        "$(t COMPOSER_SET_TEMPO) (40-240 BPM)" \
        "$COMPOSITION_TEMPO")

    [ -z "$tempo" ] && return

    # Validate tempo
    if ! [[ "$tempo" =~ ^[0-9]+$ ]] || [ "$tempo" -lt 40 ] || [ "$tempo" -gt 240 ]; then
        dialog_msgbox "$(t COMPOSER_SET_TEMPO)" "$(printf "$(t MSG_INVALID_INPUT)" "$tempo")"
        return
    fi

    COMPOSITION_TEMPO="$tempo"
    COMPOSITION_CHANGED=1
}

#
# Function: play_composition
# Description: Play current composition
#
play_composition() {
    if [ ${#COMPOSITION_NOTES[@]} -eq 0 ]; then
        dialog_msgbox "$(t COMPOSER_PLAY)" "$(t COMPOSER_EMPTY)"
        return
    fi

    # Build composition string
    local comp_str="tempo:${COMPOSITION_TEMPO} ${COMPOSITION_NOTES[*]}"

    # Create temporary file
    local temp_file=$(mktemp)
    echo "$comp_str" > "$temp_file"

    # Play using sparky-beep-compose
    local compose_cmd="${SCRIPT_DIR}/sparky-beep-compose"

    dialog_msgbox "$(t COMPOSER_PLAY)" "$(t COMPOSER_PLAYING)"

    $compose_cmd "$temp_file" -p 2>/dev/null

    rm -f "$temp_file"
}

#
# Function: preview_note
# Description: Preview a single note
#
preview_note() {
    local note="$1"

    local compose_cmd="${SCRIPT_DIR}/sparky-beep-compose"
    $compose_cmd -s "$note" -p 2>/dev/null
}

#
# Function: export_composition
# Description: Export composition to executable script
#
export_composition() {
    if [ ${#COMPOSITION_NOTES[@]} -eq 0 ]; then
        dialog_msgbox "$(t COMPOSER_EXPORT)" "$(t COMPOSER_EMPTY)"
        return
    fi

    local filename=$(dialog_inputbox \
        "$(t COMPOSER_EXPORT)" \
        "$(t COMPOSER_FILENAME)" \
        "composition.sh")

    [ -z "$filename" ] && return

    local filepath="${USER_COMPOSITIONS_DIR}/${filename}"

    # Build composition string
    local comp_str="tempo:${COMPOSITION_TEMPO} ${COMPOSITION_NOTES[*]}"

    # Create script file
    {
        echo "#!/bin/bash"
        echo "# Generated by Sparky Beep Composer"
        echo "# $(date)"
        echo ""
        echo "COMPOSITION='$comp_str'"
        echo ""
        echo "sparky-beep-compose -s \"\$COMPOSITION\" -p"
    } > "$filepath"

    chmod +x "$filepath"

    dialog_msgbox "$(t COMPOSER_EXPORT)" "$(printf "$(t COMPOSER_EXPORT_SUCCESS)" "$filepath")"
}

#
# Main program
#
main() {
    # Initialize libraries
    init_config 2>/dev/null || true
    load_config 2>/dev/null || true

    # Show main menu
    show_main_menu

    # Clean up
    rm -f "$DIALOG_TEMP"
}

# Run main program
main "$@"
