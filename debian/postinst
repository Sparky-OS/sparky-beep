#!/bin/sh
# postinst script
#
# see: dh_installdeb(1)

set -e
#SPARKY-BEEP-MAINTSCRIPT#

# the values of a 0.2.0/0.2.1 shell-format beep.conf (copied by preinst) go into the INI file
if [ -f /etc/sparky-beep/beep.conf.0.2.1 ]; then
	bash -c '. /usr/share/sparky-beep/lib/config.sh; migrate_shell_config /etc/sparky-beep/beep.conf.0.2.1 /etc/sparky-beep/beep.conf'
	mkdir -p /etc/sparky-beep/backups
	mv /etc/sparky-beep/beep.conf.0.2.1 /etc/sparky-beep/backups/
fi
dpkg-maintscript-helper rm_conffile /etc/sparky-beep/beep.conf.example 0.2.2~ sparky-beep -- "$@"

if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
	beep_step systemctl daemon-reload
	beep_step /usr/bin/sparky-beep-run
else
	beep_defer 'systemctl daemon-reload; /usr/bin/sparky-beep-run'
fi
beep_summary "postinst $1"

exit 0
