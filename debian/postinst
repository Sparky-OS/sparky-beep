#!/bin/sh
# postinst script
#
# see: dh_installdeb(1)

set -e

# the values of a 0.2.0/0.2.1 shell-format beep.conf (set aside by preinst) go into the INI file
if [ -f /etc/sparky-beep/beep.conf.0.2.1 ]; then
	bash -c '. /usr/share/sparky-beep/lib/config.sh; migrate_shell_config /etc/sparky-beep/beep.conf.0.2.1 /etc/sparky-beep/beep.conf'
	mkdir -p /etc/sparky-beep/backups
	mv /etc/sparky-beep/beep.conf.0.2.1 /etc/sparky-beep/backups/
fi
dpkg-maintscript-helper rm_conffile /etc/sparky-beep/beep.conf.example 0.2.2~ sparky-beep -- "$@"

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null 2>&1 || true
	/usr/bin/sparky-beep-run >/dev/null 2>&1 || true
fi

exit 0
