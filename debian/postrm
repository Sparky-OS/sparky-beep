#!/bin/sh
# postrm script
#
# see: dh_installdeb(1)

set -e

dpkg-maintscript-helper rm_conffile /etc/sparky-beep/beep.conf.example 0.2.2~ sparky-beep -- "$@"
if [ "$1" = "purge" ]; then
	rm -rf /etc/sparky-beep
fi
if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
