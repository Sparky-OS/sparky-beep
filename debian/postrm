#!/bin/sh
# postrm script
#
# see: dh_installdeb(1)

set -e
#SPARKY-BEEP-MAINTSCRIPT#

dpkg-maintscript-helper rm_conffile /etc/sparky-beep/beep.conf.example 0.2.2~ sparky-beep -- "$@"
if [ "$1" = "purge" ]; then
	rm -rf /etc/sparky-beep
fi
if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
	beep_step systemctl daemon-reload
else
	beep_defer 'systemctl daemon-reload'
fi
beep_summary "postrm $1"

exit 0
