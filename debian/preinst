#!/bin/sh
# preinst script
#
# see: dh_installdeb(1)

set -e

# Preserve the old shell file until dpkg has handled its conffile choice.
# Copy it for postinst migration; moving it falsely reports a local deletion.
# A locally modified conffile still uses dpkg's normal keep/replace prompt.
if [ "$1" = "upgrade" ] && grep -q '^BEEP_MODE=' /etc/sparky-beep/beep.conf 2>/dev/null; then
	cp -p /etc/sparky-beep/beep.conf /etc/sparky-beep/beep.conf.0.2.1
fi
dpkg-maintscript-helper rm_conffile /etc/sparky-beep/beep.conf.example 0.2.2~ sparky-beep -- "$@"

exit 0
