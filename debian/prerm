#!/bin/sh
# prerm script
#
# see: dh_installdeb(1)

set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ] ; then
	if [ -d /run/systemd/system ]; then
		for service in beep_sys beep_samba beep_netdata beep_webmin; do
			systemctl disable --now $service >/dev/null 2>&1 || true
		done
	fi
fi

exit 0
