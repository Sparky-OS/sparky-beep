#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable).
# Output every command that modifies files on the build system.
#export DH_VERBOSE = 1

%:
	dh $@

override_dh_installdeb:
	dh_installdeb
	set -e; for script in postinst prerm postrm; do \
		python3 debian/render-maintscript.py debian/sparky-beep/DEBIAN/$$script > debian/$$script.rendered; \
		install -m 755 debian/$$script.rendered debian/sparky-beep/DEBIAN/$$script; \
		rm debian/$$script.rendered; \
	done
